{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "baseBranchPatterns": ["valaxy"],
  "enabledManagers": ["npm"],
  "packageRules": [
    {
      "matchPackageNames": [
        "valaxy",
        "valaxy-theme-yun",
        "@valaxyjs/utils"
      ],
      "groupName": "Valaxy framework and Yun theme"
    }
  ]
}
